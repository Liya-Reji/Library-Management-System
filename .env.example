# ==============================================================
# Environment Configuration Template for Library Management System
# Copy this file to .env and adjust values for your environment.
# ==============================================================

# Server Port (Local & Container)
PORT=3000
NODE_ENV=development

# --------------------------------------------------------------
# PostgreSQL Database Connection
# --------------------------------------------------------------
# 1. For Local Docker Compose:
#    DATABASE_URL=postgres://lms_user:lms_secure_pass_123@localhost:5432/library_db
#
# 2. For Kubernetes (internal DNS):
#    DATABASE_URL=postgres://lms_user:lms_secure_pass_123@postgres-service:5432/library_db
#
# 3. For Hosted Cloud Database (Neon / Supabase / Render / AWS RDS for Netlify):
#    DATABASE_URL=postgresql://username:password@ep-xyz.aws.neon.tech/library_db?sslmode=require
#    DB_SSL=true

DATABASE_URL=postgres://lms_user:lms_secure_pass_123@localhost:5432/library_db
DB_SSL=false
DB_POOL_MAX=10

# --------------------------------------------------------------
# Security & Authentication
# --------------------------------------------------------------
# Provide a strong, unpredictable random string in production
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_random
JWT_EXPIRES_IN=24h

# --------------------------------------------------------------
# Optional: Parameters for 'npm run admin:create' script
# --------------------------------------------------------------
# ADMIN_NAME="System Administrator"
# ADMIN_USERNAME="admin"
# ADMIN_EMAIL="admin@college.edu"
# ADMIN_PASSWORD="ChangeMeAdmin123!"
